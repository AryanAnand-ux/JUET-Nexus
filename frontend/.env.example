# Frontend Environment Configuration (One-Hop Vercel Serverless)

# Upstream CampusLynx Portal API Base URL (used by /api/proxy/*)
PORTAL_BASE_URL=https://studentportal.juet.ac.in/StudentPortalAPI

# Portal TLS verification ('false' for incomplete upstream cert chain)
PORTAL_REJECT_UNAUTHORIZED=false

# Public site URL used for canonical links, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://juetnexus.vercel.app

# Node Environment
NODE_ENV=development
