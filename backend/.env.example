# Backend Environment Configuration

# Data provider: the student backend to serve.
#   campuslynx (default) JUET Student Portal JSON API
#   webkiosk             legacy scraped WebKiosk flow (fallback)
DATA_PROVIDER=campuslynx

# Student Portal (CampusLynx) API base. Overrides the built-in default; the
# portal's own clock is Asia/Kolkata -- PORTAL_TIMEZONE only needs setting if
# the portal ever moves timezones. It must NOT follow the host's TZ.
PORTAL_BASE_URL=https://studentportal.juet.ac.in/StudentPortalAPI
PORTAL_TIMEZONE=Asia/Kolkata

# WebKiosk URLs (only used when DATA_PROVIDER=webkiosk)
WEBKIOSK_BASE_URL=https://webkiosk.juet.ac.in
WEBKIOSK_URL=https://webkiosk.juet.ac.in
WEBKIOSK_LOGIN_PAGE=/
WEBKIOSK_AUTH_ACTION=/CommonFiles/UserAction.jsp
WEBKIOSK_PROFILE_PAGE=/jsp/StudentProfile.jsp
WEBKIOSK_NOTICE_PAGE=/jsp/NoticeBoardView.jsp

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Encryption Key (256-bit hex - 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-256-bit-hex-key-here-64-characters-minimum

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=10000

# Push notifications (VAPID). If unset, the server generates a throwaway pair
# at boot and push delivery silently does nothing -- set real keys for prod.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email Feedback Delivery (delivers feedback to juetnexus@gmail.com)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=juetnexus@gmail.com
GMAIL_APP_PASSWORD=
# SMTP_PASS=
# Optional custom SMTP host (defaults to Gmail service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
