# Backend Environment Configuration - JUET Nexus

# Data provider: CampusLynx (studentportal.juet.ac.in)
DATA_PROVIDER=campuslynx

# Student Portal (CampusLynx) API base
PORTAL_BASE_URL=https://studentportal.juet.ac.in/StudentPortalAPI
PORTAL_TIMEZONE=Asia/Kolkata
# Verify the portal's TLS certificate. Defaults to false (disabled) outside
# production for compatibility with university infra. Production requires "true".
PORTAL_REJECT_UNAUTHORIZED=true

# Redis Configuration (Optional, falls back to in-memory cache)
# Full URL form takes precedence over the discrete host/port/db vars below.
# REDIS_URL=redis://:password@host:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Encryption Key (256-bit hex - 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-256-bit-hex-key-here-64-characters-minimum

# Server Configuration
PORT=3001
# Interface to bind. 0.0.0.0 exposes on all interfaces; use 127.0.0.1 for local-only.
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins (no spaces around commas)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,https://juetnexus.vercel.app,https://juet-nexus-frontend.vercel.app

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=10000

# Push notifications (VAPID). If unset, the server generates a throwaway pair
# at boot and push delivery silently does nothing -- set real keys for prod.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

