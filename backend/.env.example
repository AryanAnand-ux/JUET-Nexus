# Backend Environment Configuration - JUET Nexus

# Data provider: CampusLynx (studentportal.juet.ac.in)
DATA_PROVIDER=campuslynx

# Student Portal (CampusLynx) API base
PORTAL_BASE_URL=https://studentportal.juet.ac.in/StudentPortalAPI
PORTAL_TIMEZONE=Asia/Kolkata

# Redis Configuration (Optional, falls back to in-memory cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Encryption Key (256-bit hex - 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-256-bit-hex-key-here-64-characters-minimum

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=10000

# Push notifications (VAPID). If unset, the server generates a throwaway pair
# at boot and push delivery silently does nothing -- set real keys for prod.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email Feedback Delivery (delivers feedback to juetnexus@gmail.com)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=juetnexus@gmail.com
GMAIL_APP_PASSWORD=
# SMTP_PASS=
# Optional custom SMTP host (defaults to Gmail service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Database Storage - Supabase PostgreSQL
# Get your project URL and service_role secret key from Supabase Dashboard -> Project Settings -> API.
# Run backend/src/db/schema.sql in Supabase SQL Editor.
# If unset, feedback falls back gracefully to backend/data/feedback.json local file storage.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# SUPABASE_KEY=

